# Canonical production origin
APP_URL=https://www.casherp.com
ASSET_URL=https://www.casherp.com
CANONICAL_URL=https://www.casherp.com
# Only the bare domain is an application-level canonical redirect. The former
# app subdomain must be handled by its temporary web-server redirect and then
# removed from cPanel and DNS; it is not configured as an application host.
CANONICAL_LEGACY_HOSTS=casherp.com

# Keep authenticated cookies on the canonical application host. Existing
# Existing subdomain sessions will require one sign-in on the main domain.
SESSION_DOMAIN=www.casherp.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CORS_ALLOWED_ORIGINS=https://www.casherp.com

# Google OAuth 2.0 / Socialite. Create a Web application credential in Google
# Cloud and register the callback URI exactly as shown. The secret must remain
# in the server environment; never add it to a ZIP, repository or JavaScript.
GOOGLE_SOCIAL_LOGIN_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://www.casherp.com/auth/google/callback

# DPO Pay Option A (use credentials assigned to the current environment).
# Never commit a real or test company token to source control.
DPO_ENABLED=false
DPO_MODE=test
DPO_COMPANY_TOKEN=
DPO_SERVICE_TYPE=
DPO_SERVICE_DESCRIPTION="CashERP SaaS subscription"
DPO_API_ENDPOINT="https://secure.3gdirectpay.com/API/v6/"
DPO_PAYMENT_URL="https://secure.3gdirectpay.com/payv3.php"
DPO_PTL_MINUTES=30
DPO_HTTP_TIMEOUT=20
