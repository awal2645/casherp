APP_NAME=CashERP
APP_TITLE="CashERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
APP_LOCALE=en
APP_INSTALLED=true
ALLOW_REGISTRATION=true
DEBUGBAR_ENABLED=false

ASSET_URL=
CANONICAL_URL=
