{
  "name": "casherp-tenant-smtp-ui",
  "private": true,
  "scripts": {
    "build:smtp": "esbuild resources/js/smtp-settings-react.jsx --bundle --minify --sourcemap --outfile=public/js/smtp-settings-react.js",
    "check:smtp": "esbuild resources/js/smtp-settings-react.jsx --bundle --log-level=warning --outfile=NUL",
    "build:workspaces": "esbuild resources/js/casherp-workspaces-react.jsx --bundle --minify --sourcemap --outfile=public/js/casherp-workspaces-react.js",
    "check:workspaces": "esbuild resources/js/casherp-workspaces-react.jsx --bundle --log-level=warning --outfile=NUL",
    "build": "npm run build:smtp && npm run build:workspaces"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
